{
  "name": "agentbrain",
  "version": "0.0.1",
  "description": "Local tools for a git-backed markdown brain shared across coding agents.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agentbrain": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
