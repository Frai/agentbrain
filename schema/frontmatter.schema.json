{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Frai/agentbrain/schema/frontmatter.schema.json",
  "title": "Brain note frontmatter",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "source_tool": {
      "type": "string",
      "enum": ["human", "cursor", "claude", "claude-code", "grok-bot"]
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "supersedes": {
      "type": "string",
      "minLength": 1
    },
    "example": {
      "type": "boolean",
      "description": "True on synthetic files shipped in this repository."
    }
  },
  "required": ["source_tool", "updated", "confidence"]
}
